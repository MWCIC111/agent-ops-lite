# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Streamlit
.streamlit/secrets.toml

# Secrets（`.env.example` 是唯一可提交的模板，其余一律忽略）
# 注意 `*.env` 匹配不到 `.env.local` / `.env.production`，必须显式加 `.env.*`
.env
*.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# 运行时生成的真实 trace 数据库（含真实调用记录，不应入库）
agent_ops.db
*.db

# RAG 离线索引缓存（运行时从语料 jsonl 重建，无需入库）
rag_data/*.pkl

# 语料抓取中间产物（raw_md 原文 + manifest，由 scripts/fetch_ivd_corpus.py 生成，可重新抓取）
rag_data/_src/

# 人工审核回写数据（运行时生成，不应入库）
rag_data/reviewed.jsonl

# 播种后台任务的日志与并发锁（运行时生成，不应入库）
seed.log
.seed.lock

# 操作人员操作时间线（运行时生成，不应入库）
operations.log
