# agent-ops-lite 环境变量模板
#
# 用法：cp .env.example .env  然后填写真实值。
# ⚠ .env 已被 .gitignore 忽略（.env / *.env / .env.*），切勿提交真实 key。
# ⚠ 脚本类工具（scripts/*.py）会自己读取本文件，无需手动 export；
#    Streamlit 进程需重启后才会重新加载环境变量。

# ---- DeepSeek（真实 Agent 调用 / hard 档评测集改写）------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 主模型不可用时的回退模型，可留空
DEEPSEEK_FALLBACK_MODEL=

# ---- 调用层韧性（超时 / 重试 / 退避）--------------------------------------
AGENTOPS_REQ_TIMEOUT_S=30
AGENTOPS_MAX_RETRIES=3
AGENTOPS_BACKOFF_S=1.0

# ---- 每日成本配额（人民币），超出即熔断 ------------------------------------
AGENTOPS_DAILY_QUOTA_CNY=50

# ---- RAG ------------------------------------------------------------------
# 语料选择：ivd（默认，NMPA 器审中心指导原则 172 篇）/ ivd_naive / general / 任意 *.jsonl 路径
RAG_CORPUS=ivd
# 标题在索引中的重复次数（0 = 退回纯 content 基线，用于消融对照）
RAG_TITLE_WEIGHT=3
# 检索层硬门控 —— 「极端无支撑熔断」的两个条件（AND）
# ⚠ 阈值随语料而变，换语料后须用 scripts/eval_gate.py 重新标定
RAG_ABS_GATE=12.0
RAG_RATIO_GATE=1.14

# ---- 告警（留空则只打印到日志）--------------------------------------------
AGENTOPS_WEBHOOK_URL=
AGENTOPS_WEBHOOK_TYPE=wecom
